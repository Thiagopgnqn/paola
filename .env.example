# Base de datos PostgreSQL
DATABASE_URL="postgresql://paola:paola_local_dev@localhost:5432/paola_calzados?schema=public"

# JWT (Obligatorios en producción)
JWT_ACCESS_SECRET="[GENERAR_SECRETO_JWT_ACCESS_SEGURO]"
JWT_REFRESH_SECRET="[GENERAR_SECRETO_JWT_REFRESH_SEGURO]"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# WhatsApp — Número de Paola Calzados (con código de país, sin + ni espacios)
# Completar con el número comercial real antes de pasar a producción.
WHATSAPP_PHONE="[WHATSAPP]"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Admin seed (usuario administrador inicial)
ADMIN_EMAIL="[EMAIL_ADMIN]"
ADMIN_PASSWORD="[PASSWORD_ADMIN_SEGURO]"

# Cloudinary (Subida de imágenes — carpeta recomendada: paola-calzados)
CLOUDINARY_CLOUD_NAME="[CLOUDINARY_CLOUD_NAME]"
CLOUDINARY_API_KEY="[CLOUDINARY_API_KEY]"
CLOUDINARY_API_SECRET="[CLOUDINARY_API_SECRET]"

# Meta Pixel & API de Conversiones (Opcional — si falta, no se ejecuta)
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
VITE_META_PIXEL_ID=""
