# ==============================================================================
# PAOLA CALZADOS — Configuración de Entorno (Frontend)
# ==============================================================================

# MODO DEMO (para desplegar en Vercel sin backend ni base de datos online)
# Si VITE_DEMO_MODE=true, todas las llamadas a la API se resuelven en el
# navegador usando src/api/demo/demo-data.json y persistencia en localStorage
# (clave "paola-demo-state"). Credenciales demo admin: admin@paolacalzados.demo / demo1234.
# Si no está definida o es false, la aplicación se conecta normalmente al backend real (Express + Prisma).
VITE_DEMO_MODE=true

# Número de WhatsApp de PRUEBA utilizado para generar el mensaje de checkout en modo demo
# (NÚMERO FICTICIO DE TEST — reemplazar por el WhatsApp real confirmado con la clienta)
VITE_DEMO_WHATSAPP=5493510000000

# URL de la API del backend real (solo se usa cuando VITE_DEMO_MODE no está activa)
# VITE_API_URL=http://localhost:3001/api

# Píxel de Meta en el navegador (en modo demo o sin ID configurado se desactiva automáticamente)
# VITE_META_PIXEL_ID=[META_PIXEL_ID]
